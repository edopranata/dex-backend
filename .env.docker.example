# Konfigurasi production (Docker). Di server: salin ke backend/.env (deploy/server-setup.sh melakukannya
# otomatis dan mengisi rahasia). File .env lokal untuk development tetap terpisah di laptop.

# --- Akses ---
# Sekarang: http://IP_SERVER:8080 (deploy/server-setup.sh mengisi IP otomatis).
# Nanti via Cloudflare Tunnel: APP_URL=https://dexsim.domain.com, SANCTUM_STATEFUL_DOMAINS=dexsim.domain.com,
#   SESSION_SECURE_COOKIE=true, WEB_BIND=127.0.0.1 (port 8080 tidak lagi terbuka ke internet).
WEB_BIND=0.0.0.0
WEB_PORT=8080
APP_URL=http://IP_SERVER:8080
# Host persis seperti di address bar browser (termasuk port jika ada), tanpa http://
SANCTUM_STATEFUL_DOMAINS=IP_SERVER:8080
SESSION_SECURE_COOKIE=false

# --- Laravel ---
APP_NAME="DEX Simulator"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_LOCALE=en
# File harian (dibaca di Admin > Log) + stderr (docker compose logs)
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DAILY_DAYS=14
LOG_LEVEL=info

# Folder backup di host (cron menulis ke sini; aplikasi membaca & membuat backup manual)
BACKUP_HOST_PATH=/var/backups/dex
BACKUP_COOLDOWN_MINUTES=60

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dex
DB_USERNAME=dex
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# ~20% RAM VPS (6 GB -> 1G)
MYSQL_BUFFER_POOL=1G

SESSION_DRIVER=database
SESSION_LIFETIME=720
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=660
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=log

# --- Simulator ---
SIM_STARTING_BALANCE=10000
SIM_FEE_RATE=0.003
SIM_MAX_TOKENS=20

# --- Market data ---
GECKOTERMINAL_RPM=10
WHALE_MIN_USD=10000
WHALE_FLOOR_USD=1000
DISCOVERY_AUTO_TRACK=true
COINGECKO_DEMO_API_KEY=

# --- AI (none | gemini | openai) ---
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Notifikasi Telegram (bisa juga diisi dari Admin → Pengaturan → Telegram)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# Token for deploy/monitor.sh (container status in Admin > Sistem). Made by server-setup.sh.
MONITOR_TOKEN=
